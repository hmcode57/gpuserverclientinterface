+// "cuda" / "vulkan" = only that one, "cpu" = CPU.
+[[maybe_unused]] bool use_cuda() {
+    const char *choice = std::getenv("KIMODO_BACKEND");
+    return !choice || std::string_view(choice) == "cuda";
 }
 
