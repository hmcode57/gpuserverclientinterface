   target_compile_definitions(kmd-encode PRIVATE KIMODO_HAVE_GGML=1 ${KIMODO_VK_DEFS})
+  add_executable(kmd-encode-serve src/encode_serve.cpp)
+  target_sources(kmd-encode-serve PRIVATE src/llm_text_encoder.cpp src/llm_tokenizer.cpp)
+  target_include_directories(kmd-encode-serve PRIVATE src)
